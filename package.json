{
  "name": "gappy-sales-demo-bundle",
  "version": "1.0.0",
  "private": true,
  "description": "Gappy Sales Demo Bundle - Preconfigured demo environment with sample data",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @gappy/database db:generate",
    "db:push": "pnpm --filter @gappy/database db:push",
    "db:migrate": "pnpm --filter @gappy/database db:migrate",
    "db:studio": "pnpm --filter @gappy/database db:studio",
    "sample-data:seed": "pnpm --filter @gappy/sample-data seed",
    "demo:shibuya": "pnpm sample-data:seed -- --profile shibuya_demo --days 30 --users 500",
    "demo:osaka": "pnpm sample-data:seed -- --profile osaka_demo --days 30 --users 300"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
