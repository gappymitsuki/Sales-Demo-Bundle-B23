{
  "name": "@gappy/sample-data",
  "version": "1.0.0",
  "private": true,
  "description": "Sample data generator for Gappy demo environments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gappy-seed": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "seed": "tsx src/cli.ts",
    "summary": "tsx src/scripts/printDemoSummary.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gappy/database": "workspace:*",
    "@faker-js/faker": "^8.4.1",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
